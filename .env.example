# Multica Daemon Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Your Multica authentication token
# Generate this from your self-hosted Multica instance settings
MULTICA_TOKEN=your-token-here

# Self-hosted server URLs
# For local deployment (default):
MULTICA_SERVER_URL=http://localhost:8080
MULTICA_APP_URL=http://localhost:3000

# For on-premise deployment with custom domains:
# MULTICA_SERVER_URL=https://api.example.com
# MULTICA_APP_URL=https://app.example.com

# Optional: Daemon configuration
MULTICA_DAEMON_POLL_INTERVAL=3s
MULTICA_DAEMON_HEARTBEAT_INTERVAL=15s
MULTICA_DAEMON_MAX_CONCURRENT_TASKS=20
MULTICA_AGENT_TIMEOUT=2h

# Optional: Custom device name (defaults to hostname)
# MULTICA_DAEMON_DEVICE_NAME=my-daemon-01

# ============================================================================
# Git Configuration for Private Repositories
# ============================================================================
# Choose ONE of the two methods below:

# METHOD 1: SSH Key Authentication (recommended for development)
# Path to your SSH private key (will be mounted read-only into the container)
# On Windows: C:/Users/YourUsername/.ssh/id_rsa or /mnt/c/Users/YourUsername/.ssh/id_rsa
# On Linux/Mac: ~/.ssh/id_rsa
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# Optional: Mount custom SSH config file (uncomment volume in docker-compose.yml)
# SSH_CONFIG_PATH=~/.ssh/config

# Optional: Mount existing known_hosts file (uncomment volume in docker-compose.yml)
# SSH_KNOWN_HOSTS_PATH=~/.ssh/known_hosts

# METHOD 2: HTTPS with Personal Access Token (alternative to SSH)
# Uncomment and configure these if you prefer HTTPS over SSH:
GIT_USERNAME=your-git-username
GIT_TOKEN=your-personal-access-token
GIT_CREDENTIAL_HELPER=store  # Options: store, cache, or empty to disable

# Git user configuration (optional, but recommended for commits)
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=your.email@example.com

# Agent CLI Installation (build-time configuration)
# Set to 'true' to install each agent CLI, 'false' to skip
# At least one agent must be enabled for the daemon to work
INSTALL_OPENCODE=true
INSTALL_CLAUDE=false
INSTALL_COPILOT=false
INSTALL_CODEX=false
INSTALL_OPENCLAW=false
INSTALL_HERMES=false
INSTALL_GEMINI=false
INSTALL_CURSOR=false

# ============================================================================
# MCP (Model Context Protocol) Configuration
# ============================================================================
# MCP servers provide additional context and tools to AI agents.
# Configure mcp.json to define which servers to use, and set their
# required environment variables below.

# Outline Documentation Server
# OUTLINE_API_KEY=ol_api_your_api_key_here

# GitHub Integration
# GITHUB_TOKEN=ghp_your_github_personal_access_token

# PostgreSQL Database Access
# DATABASE_URL=postgresql://user:password@host:5432/database

# Slack Integration
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_TEAM_ID=T1234567890

# Custom API Keys (add as needed for your MCP servers)
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_SERVICE_URL=https://api.example.com
